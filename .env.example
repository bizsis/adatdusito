APP_DATABASE_URL=mysql+pymysql://adatdusito_app:CHANGE_ME@172.28.10.1:3306/adatdusito_dev
REFERENCE_DATABASE_URL=mysql+pymysql://adatdusito_ref:CHANGE_ME@172.28.10.1:3306/pinfo_db
REDIS_URL=redis://redis:6379/0

# HTTPS on the existing dev domain; false is allowed only for isolated local HTTP.
APP_ORIGIN=https://dev.pinfo.hu
COOKIE_SECURE=true

# Password hashing: scrypt needs ~128 MiB per operation. At most this many run
# at once per container (shared across all Uvicorn worker processes); further
# requests wait up to SCRYPT_QUEUE_TIMEOUT seconds, then get HTTP 503 + Retry-After.
SCRYPT_CONCURRENCY=2
SCRYPT_QUEUE_TIMEOUT=5
